# ───────────── Nelis3D environment ─────────────
# Copy to .env.local and fill in. NEVER commit real keys.

# --- Database -------------------------------------------------------
# SQLite file (default). Created automatically on first start.
# (SQLite was replaced by Postgres – see DATABASE_URL below)

# --- File storage ---------------------------------------------------
# "local" writes to STORAGE_LOCAL_DIR. (S3/R2 driver: see README → Storage)
STORAGE_DRIVER=local   # local | postgres
STORAGE_LOCAL_DIR=./data/storage

# --- AI providers ---------------------------------------------------
# auto  = use whatever keys are present (recommended)
# local = geometry templates only, no external AI (works fully offline)
AI_PROVIDER=auto

# Vision analysis + chat + parametric part design (Claude).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Photo → 3D mesh reconstruction (Meshy multi-image-to-3D). Paid API.
MESHY_API_KEY=
MESHY_AI_MODEL=latest

# --- Auth -----------------------------------------------------------
# v1 uses a single development user. Replace lib/auth.ts for real accounts.
DEV_USER_EMAIL=dev@nelis3d.local

# --- Privacy --------------------------------------------------------
# Delete uploaded scan photos this many hours after a model was built (0 = keep).
SCAN_IMAGE_RETENTION_HOURS=0

# --- Vercel / serverless ----------------------------------------------
# DATABASE_URL: Postgres connection string (Neon etc.). Unset locally ⇒ embedded PGlite in ./data/pglite.
# STORAGE_DRIVER: defaults to "postgres" when DATABASE_URL/VERCEL is set, otherwise "local".
# CRON_SECRET: random string; Vercel sends it as a Bearer token to /api/cron/maintenance.
DATABASE_URL=
CRON_SECRET=
